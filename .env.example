# AI provider
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=

# PostgreSQL
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Backend
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_REFRESH_TOKEN_EXPIRATION_MS=2592000000
APP_REFRESH_COOKIE_SECURE=false
APP_REFRESH_COOKIE_SAME_SITE=Lax

# Demo data seeding (development only)
# Set to true to seed demo data on startup. This is idempotent - running multiple times will not create duplicates.
# WARNING: Never enable in production.
APP_SEED_DEMO_DATA=false
